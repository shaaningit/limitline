# Copy to .env.local for local development, and add the same names in Vercel
# (Project → Settings → Environment Variables). Never commit real values.

# Supabase project (Project Settings → API). The publishable key is safe in the browser.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Where the app lives, used in login and result email links. No trailing slash.
APP_URL=https://limitline.app

# Extra login buttons. Set to "on" only after their optional steps in SETUP.md.
NEXT_PUBLIC_LOGIN_GOOGLE=
NEXT_PUBLIC_LOGIN_PHONE=

# Resend (after verifying your domain). Secret: server only.
RESEND_API_KEY=re_...
EMAIL_FROM="LIMITLINE <hello@limitline.app>"

# One time zone for weekly boards (IANA name), e.g. Europe/London, Asia/Kolkata.
PILOT_TIME_ZONE=Europe/London

# Shown in the first-run checklist and the data-deletion link.
NEXT_PUBLIC_FOUNDER_STRAVA_NAME="Your Strava name"
NEXT_PUBLIC_FOUNDER_EMAIL=you@example.com
